{
    "manifest_version": 3,
    "name": "Human Typer",
    "version": "1.0",
    "description": "Simulates human typing with pauses",
    "permissions": ["activeTab", "scripting"],
    "action": 
    {
        "default_popup": "popup.html"
    },
    "content_scripts":  
    [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}